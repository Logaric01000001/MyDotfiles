# --- HISTORIALES Y SESIONES PRIVADAS ---
.zsh_history
*.history
.bash_history
.lesshst
.wget-hsts
.python_history
.node_repl_history
.gdb_history
*.log

# --- CLAVES PRIVADAS, CREDENCIALES Y TOKENS ---
*.pem
*.key
*.pub
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.keystore
*.pfx
*.p12
.env
.env.*
secrets.*
*credentials*
*.secret

