{
  "mcpServers": {
    "StitchMCP": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://stitch.googleapis.com/mcp",
        "--header",
        "X-Goog-Api-Key: YOUR_API_KEY_HERE"
      ]
    },
    "notion-mcp-server": {
      "command": "npx",
      "args": [
        "-y",
        "@notionhq/notion-mcp-server"
      ],
      "env": {
        "OPENAPI_MCP_HEADERS": "{\"Authorization\": \"Bearer YOUR_NOTION_KEY_HERE\", \"Notion-Version\": \"2022-06-28\"}"
      }
    },
    "canva": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.canva.com/mcp"
      ]
    },
    "BugBountyMCP": {
      "command": "python",
      "args": [
        "bug_bounty_mcp.py"
      ],
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    }
  }
}
