[Unit]
Description=Limpieza mensual profunda (Docker e imágenes no usadas)
Documentation=file:///home/logaric/MyDotfiles/scripts/limpia
After=graphical-session.target

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:%h/.local/share/pnpm/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/limpia --only docker --docker-all --yes --notify
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=1h
