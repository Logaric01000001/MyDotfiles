[Unit]
Description=Limpieza semanal de cachés y temporales del usuario
Documentation=file:///home/logaric/MyDotfiles/scripts/limpia
After=graphical-session.target

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:%h/.local/share/pnpm/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/limpia --only cache,dev,papelera,flatpak,docker,navegadores --yes --notify
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=30min
