// niri config

// autostart
spawn-at-startup "noctalia"
spawn-at-startup "bash" "-c" "sleep 2 && PATH=$HOME/.local/bin:$PATH restore-state.sh"
spawn-at-startup "protonvpn" "connect"
spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"
// spawn-at-startup "mako"

// no apagar pantallas por inactividad; bloquear solo si el usuario suspende manualmente
spawn-at-startup "swayidle" "-w" \
    "before-sleep" "bash -c 'PATH=$HOME/.local/bin:$PATH lock-screen'"

prefer-no-csd

environment {
    QT_QPA_PLATFORM "wayland;xcb"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
}

screenshot-path "~/Imágenes/Capturas/screenshot-%Y-%m-%d-%H-%M-%S.png"

input {
    keyboard {
        xkb {
            layout "latam"
        }
        repeat-delay 300
        repeat-rate 50
    }

    touchpad {
        tap
        dwt
        natural-scroll
        accel-speed 0.2
        accel-profile "adaptive"
        middle-emulation
    }

    mouse {
        accel-speed 0.0
        accel-profile "flat"
    }

    focus-follows-mouse
}

// laptop
output "eDP-1" {
    scale 1.0
    position x=0 y=0
}

// externos, siempre a la derecha
output "HDMI-A-1" {
    scale 1.0
    position x=1366 y=0
}

output "HDMI-A-2" {
    scale 1.0
    position x=1366 y=0
}

output "DP-1" {
    scale 1.0
    position x=1366 y=0
}

output "DP-2" {
    scale 1.0
    position x=1366 y=0
}

layout {
    gaps 8
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 3
        active-gradient from="#cba6f7" to="#89b4fa" angle=45
        inactive-color "#313244"
    }

    border {
        off
    }

    struts {
        left 0
        right 0
        top 0
        bottom 0
    }
}

animations {
    workspace-switch {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    window-open {
        duration-ms 180
        curve "ease-out-expo"
    }

    window-close {
        duration-ms 180
        curve "ease-out-expo"
    }

    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    window-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    window-resize {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
}

window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

window-rule {
    match app-id=r#"^(dolphin|org\.kde\.dolphin)$"#
    opacity 1.0
}

// flotantes
window-rule {
    match app-id=r#"^(pavucontrol|org\.pulseaudio\.pavucontrol|nm-connection-editor|blueman-manager)$"#
    match app-id=r#"^(org\.gnome\.Calculator|org\.kde\.polkit-kde-authentication-agent-1|polkit-gnome-authentication-agent-1)$"#
    match app-id=r#"^(xdg-desktop-portal-gtk|xdg-desktop-portal-gnome|xdg-desktop-portal-kde)$"#
    open-floating true
}

window-rule {
    match title=r#"^(Abrir|Guardar|Open|Save|Confirmar|Confirmación|Properties|Configuración|Preferences)$"#
    open-floating true
}

window-rule {
    match app-id="wl-mirror"
    open-fullscreen true
}

// borde rojo en la ventana que se está compartiendo
window-rule {
    match is-window-cast-target=true
    focus-ring {
        active-color "#f38ba8"
        inactive-color "#45475a"
    }
}

binds {
    // Mod+M       { spawn "spotify"; }
    // Mod+T       { spawn "telegram-desktop"; }
    // Mod+Shift+N { spawn "obsidian"; }

    Mod+Shift+H     { spawn "bash" "-c" "PATH=$HOME/.local/bin:$PATH help-menu"; }
    Mod+Shift+Slash { spawn "bash" "-c" "PATH=$HOME/.local/bin:$PATH help-menu"; }
    Mod+Shift+E { quit; }
    Mod+Shift+Q { close-window; }
    Mod+Q { close-window; }

    Mod+L { spawn "bash" "-c" "PATH=$HOME/.local/bin:$PATH lock-screen"; } // Bloquear
    Mod+S { spawn "bash" "-c" "PATH=$HOME/.local/bin:$PATH power-menu.sh"; } // Menu de energia
    Mod+P       { spawn "bash" "-c" "PATH=$HOME/.local/bin:$PATH display-mode.sh"; } // Modo de pantalla
    Mod+Shift+D { spawn "bash" "-c" "PATH=$HOME/.local/bin:$PATH display-mode.sh"; } // Modo de pantalla
    Mod+A { spawn "noctalia" "msg" "settings-open"; } // Ajustes de Noctalia

    // apps
    Mod+Return { spawn "kitty"; } // Terminal
    Mod+C { spawn "bash" "-c" "antigravity-ide || codium || vscodium || code"; } // Editor
    Mod+D     { spawn "rofi" "-show" "drun"; } // Apps
    Mod+Space { spawn "rofi" "-show" "drun"; } // Apps
    Mod+B { spawn "zen-browser"; } // Navegador
    Mod+E { spawn "dolphin"; } // Archivos

    Mod+W       { spawn "bash" "-c" "PATH=$HOME/.local/bin:$PATH set-wallpaper select-all"; } // Wallpaper (escritorio + sddm)
    Mod+Ctrl+W  { spawn "bash" "-c" "PATH=$HOME/.local/bin:$PATH set-wallpaper select-inside"; } // Wallpaper (escritorio)
    Mod+Alt+W   { spawn "bash" "-c" "PATH=$HOME/.local/bin:$PATH set-wallpaper select-outside"; } // Wallpaper (sddm)
    Mod+Shift+W { spawn "bash" "-c" "PATH=$HOME/.local/bin:$PATH set-wallpaper select-outside"; } // Wallpaper (sddm)

    // foco
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+H { focus-column-left; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }

    // mover
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Down  { move-window-down; }
    Mod+Shift+Up    { move-window-up; }

    // monitores
    Mod+Shift+Ctrl+Left  { focus-monitor-left; }
    Mod+Shift+Ctrl+Right { focus-monitor-right; }
    Mod+Alt+Left  { move-column-to-monitor-left; }
    Mod+Alt+Right { move-column-to-monitor-right; }

    // workspaces
    Mod+Page_Down      { focus-workspace-down; }
    Mod+Page_Up        { focus-workspace-up; }
    Mod+Ctrl+Down      { focus-workspace-down; }
    Mod+Ctrl+Up        { focus-workspace-up; }
    Mod+Ctrl+J         { focus-workspace-down; }
    Mod+Ctrl+K         { focus-workspace-up; }

    Mod+Shift+Page_Down { move-column-to-workspace-down; }
    Mod+Shift+Page_Up   { move-column-to-workspace-up; }
    Mod+Ctrl+Shift+Down { move-column-to-workspace-down; }
    Mod+Ctrl+Shift+Up   { move-column-to-workspace-up; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    // tamaño
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { reset-window-height; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+M { maximize-column; }
    Mod+Shift+C { center-column; }

    Mod+V { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; } // Subir volumen
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; } // Bajar volumen
    XF86AudioMute        allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; } // Mute
    XF86AudioMicMute     allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; } // Mute mic
    XF86AudioPlay        allow-when-locked=true { spawn "playerctl" "play-pause"; } // Play/pausa
    XF86AudioNext        allow-when-locked=true { spawn "playerctl" "next"; } // Siguiente
    XF86AudioPrev        allow-when-locked=true { spawn "playerctl" "previous"; } // Anterior

    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "set" "+5%"; } // Subir brillo
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "5%-"; } // Bajar brillo

    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }
}
