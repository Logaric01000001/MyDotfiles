{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": [
    "openrouter"
  ],
  "model": "openrouter/deepseek/deepseek-v3.2",
  "small_model": "openrouter/deepseek/deepseek-v3.2",
  "default_agent": "sc-build",
  "share": "disabled",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 12000
  },
  "permission": {
    "external_directory": {
      "*": "ask",
      "~/.config/opencode/skills/webn-opt/references/**": "allow"
    },
    "doom_loop": "ask",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "rg *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "pnpm test*": "allow",
      "pnpm run lint*": "allow",
      "pnpm run build*": "allow",
      "git push*": "deny",
      "git reset --hard*": "deny",
      "rm -rf*": "deny"
    },
    "skill": {
      "*": "allow"
    }
  },
  "agent": {
    "sc-quick": {
      "description": "Consultas cortas y cambios pequeños, mínimo coste.",
      "mode": "primary",
      "model": "openrouter/deepseek/deepseek-v4-flash-0731",
      "prompt": "{file:./prompts/sc-quick.txt}",
      "steps": 4
    },
    "sc-build": {
      "description": "Trabajo universal con pruebas y bajo consumo.",
      "mode": "primary",
      "model": "openrouter/deepseek/deepseek-v4-flash-0731",
      "prompt": "{file:./prompts/sc-build.txt}",
      "steps": 12
    },
    "sc-deep": {
      "description": "Arquitectura y problemas complejos con DeepSeek V4.1.",
      "mode": "primary",
      "model": "openrouter/deepseek/deepseek-v4.1-flash-1017",
      "prompt": "{file:./prompts/sc-deep.txt}",
      "steps": 12
    },
    "sc-audit": {
      "description": "Auditoría primaria en modo lectura.",
      "mode": "primary",
      "model": "openrouter/deepseek/deepseek-v4-flash-0731",
      "prompt": "{file:./prompts/sc-review.txt}",
      "steps": 5,
      "permission": {
        "edit": "deny",
        "bash": "ask"
      }
    },
    "sc-review": {
      "description": "Auditoría de cambios en modo lectura.",
      "mode": "subagent",
      "model": "openrouter/deepseek/deepseek-v4-flash-0731",
      "prompt": "{file:./prompts/sc-review.txt}",
      "steps": 5,
      "permission": {
        "edit": "deny",
        "bash": "ask"
      }
    }
  }
}
