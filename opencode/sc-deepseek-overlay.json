{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": [
    "openrouter"
  ],
  "model": "openrouter/deepseek/deepseek-v4-flash-0731",
  "small_model": "openrouter/deepseek/deepseek-v4-flash-0731",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 12000
  },
  "agent": {
    "budget-build": {
      "description": "Agente principal económico para desarrollar, investigar y ejecutar tareas acotadas.",
      "mode": "primary",
      "model": "openrouter/deepseek/deepseek-v4-flash-0731",
      "steps": 10,
      "temperature": 0.2,
      "permission": {
        "task": "ask"
      }
    },
    "deep-solve": {
      "description": "Agente avanzado por elección explícita para problemas difíciles y revisiones de arquitectura.",
      "mode": "primary",
      "model": "openrouter/deepseek/deepseek-v4.1-flash-1017",
      "steps": 8,
      "temperature": 0.2,
      "permission": {
        "task": "ask"
      }
    }
  },
  "permission": {
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "ls *": "allow",
      "rg *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git push*": "deny",
      "git reset --hard*": "deny",
      "rm -rf*": "deny"
    },
    "edit": "allow",
    "external_directory": "ask",
    "doom_loop": "ask",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    }
  }
}
