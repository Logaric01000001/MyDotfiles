#!/usr/bin/env bash
# =============================================================================
#   Arch Linux & Environment Intelligent Updater
#   Comando: actualizacion [opciones]
#   Actualiza el sistema (Pacman + AUR + Flatpaks + Skills), mantiene el caché
#   y sincroniza/verifica la configuración del entorno (dotfiles y compositor).
# =============================================================================

set -eo pipefail

# Colores y formato
BOLD='\033[1m'
CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
RED='\033[0;31m'
NC='\033[0m'

log_info()    { echo -e "${BLUE}[INFO]${NC} $1"; }
log_ok()      { echo -e "${GREEN}[ OK ]${NC} $1"; }
log_warn()    { echo -e "${YELLOW}[AVISO]${NC} $1"; }
log_err()     { echo -e "${RED}[ERROR]${NC} $1"; }
log_header()  {
    echo -e "\n${CYAN}═══════════════════════════════════════════════════════════════${NC}"
    echo -e "${BOLD}${CYAN}  $1 ${NC}"
    echo -e "${CYAN}═══════════════════════════════════════════════════════════════${NC}"
}

# Parámetros y opciones
TARGET_PARALLEL=""
EXTRA_ARGS=()
SKIP_FLATPAK=false
SKIP_SKILLS=false
SKIP_SYNC=false
ONLY_CHECK=false

show_help() {
    cat <<EOF
Uso: actualizacion [opciones] [n_descargas] [argumentos_paru]

Opciones principales:
  -h, --help        Muestra esta ayuda y sale.
  -c, --check       Verifica el estado del entorno y paquetes pendientes (sin actualizar).
  --no-flatpak      Omite la actualización de aplicaciones Flatpak.
  --no-skills       Omite la actualización de Agent Skills de Antigravity.
  --no-sync         Omite la verificación y sincronización de dotfiles y entorno.
  [1-9]             Número de descargas paralelas para pacman (ej: actualizacion 5).

Ejemplos:
  actualizacion                 Actualización interactiva completa de todo el entorno.
  actualizacion 5               Fija 5 descargas paralelas y actualiza.
  actualizacion --check         Verifica paquetes y estado sin modificar el sistema.
  actualizacion --noconfirm     Actualización desatendida.
EOF
}

# Procesamiento de argumentos
while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help)
            show_help
            exit 0
            ;;
        -c|--check|--dry-run)
            ONLY_CHECK=true
            shift
            ;;
        --no-flatpak)
            SKIP_FLATPAK=true
            shift
            ;;
        --no-skills)
            SKIP_SKILLS=true
            shift
            ;;
        --no-sync)
            SKIP_SYNC=true
            shift
            ;;
        [1-9]|[1-9][0-9])
            TARGET_PARALLEL="$1"
            shift
            ;;
        *)
            EXTRA_ARGS+=("$1")
            shift
            ;;
    esac
done

DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." 2>/dev/null && pwd)"
[ -d "$HOME/MyDotfiles" ] && DOTFILES_DIR="$HOME/MyDotfiles"

log_header "ACTUALIZADOR INTELIGENTE DEL ENTORNO"

# -----------------------------------------------------------------------------
# FASE 0: Modo comprobación / check
# -----------------------------------------------------------------------------
if [ "$ONLY_CHECK" = true ]; then
    log_info "Modo verificación activo. Consultando paquetes pendientes..."
    if command -v checkupdates >/dev/null 2>&1; then
        PENDING_ARCH=$(checkupdates 2>/dev/null || true)
    else
        PENDING_ARCH=$(pacman -Qu 2>/dev/null || true)
    fi

    if [ -n "$PENDING_ARCH" ]; then
        COUNT_ARCH=$(echo "$PENDING_ARCH" | wc -l)
        echo -e "${YELLOW}Actualizaciones oficiales pendientes ($COUNT_ARCH):${NC}"
        echo "$PENDING_ARCH" | head -n 15
        [ "$COUNT_ARCH" -gt 15 ] && echo "... y $((COUNT_ARCH - 15)) más."
    else
        log_ok "Repositorios oficiales al día."
    fi

    if command -v paru >/dev/null 2>&1; then
        PENDING_AUR=$(paru -Qua 2>/dev/null || true)
        if [ -n "$PENDING_AUR" ]; then
            COUNT_AUR=$(echo "$PENDING_AUR" | wc -l)
            echo -e "\n${YELLOW}Actualizaciones de AUR pendientes ($COUNT_AUR):${NC}"
            echo "$PENDING_AUR"
        else
            log_ok "Paquetes de AUR al día."
        fi
    fi

    if command -v flatpak >/dev/null 2>&1; then
        PENDING_FP=$(flatpak remote-ls --updates 2>/dev/null || true)
        if [ -n "$PENDING_FP" ]; then
            echo -e "\n${YELLOW}Actualizaciones de Flatpak pendientes:${NC}"
            echo "$PENDING_FP"
        else
            log_ok "Flatpaks al día."
        fi
    fi

    log_ok "Verificación de entorno completada."
    exit 0
fi

# -----------------------------------------------------------------------------
# FASE 1: Comprobación de bloqueos y optimizaciones de pacman
# -----------------------------------------------------------------------------
log_header "1/7. COMPROBACIÓN DEL SISTEMA Y PACMAN"

# Verificar db.lck
if [ -f /var/lib/pacman/db.lck ]; then
    LCK_PID=$(lsof -t /var/lib/pacman/db.lck 2>/dev/null || true)
    if [ -n "$LCK_PID" ] && ps -p "$LCK_PID" >/dev/null 2>&1; then
        log_err "Pacman o Paru se está ejecutando actualmente (PID: $LCK_PID)."
        log_err "Espera a que el proceso termine antes de continuar."
        exit 1
    else
        log_warn "Se detectó un archivo de bloqueo huérfano (/var/lib/pacman/db.lck)."
        if [ -t 0 ]; then
            read -rp "¿Deseas eliminar el bloqueo huérfano para continuar? [s/N]: " rm_lock
            if [[ "$rm_lock" =~ ^[sS]$ ]]; then
                sudo rm -f /var/lib/pacman/db.lck
                log_ok "Bloqueo eliminado."
            else
                log_err "Actualización cancelada por bloqueo."
                exit 1
            fi
        else
            sudo rm -f /var/lib/pacman/db.lck
            log_ok "Bloqueo huérfano eliminado automáticamente."
        fi
    fi
else
    log_ok "Base de datos de paquetes libre (sin bloqueos)."
fi

# Descargas paralelas
CURRENT_PARALLEL=$(grep -E "^[#[:space:]]*ParallelDownloads" /etc/pacman.conf 2>/dev/null | grep -o -E "[0-9]+" | head -n1 || true)
CURRENT_PARALLEL="${CURRENT_PARALLEL:-5}"

if [ -z "$TARGET_PARALLEL" ] && [ -t 0 ]; then
    read -rp "Descargas paralelas para pacman [$CURRENT_PARALLEL]: " input_parallel
    [[ "$input_parallel" =~ ^[1-9][0-9]*$ ]] && TARGET_PARALLEL="$input_parallel"
fi

if [ -n "$TARGET_PARALLEL" ] && [ "$TARGET_PARALLEL" -ne "$CURRENT_PARALLEL" ]; then
    if grep -q -E "^[#[:space:]]*ParallelDownloads" /etc/pacman.conf; then
        sudo sed -i -E "s/^[#[:space:]]*ParallelDownloads[[:space:]]*=.*/ParallelDownloads = $TARGET_PARALLEL/" /etc/pacman.conf
    else
        sudo sed -i "/\[options\]/a ParallelDownloads = $TARGET_PARALLEL" /etc/pacman.conf
    fi
    log_ok "ParallelDownloads configurado en $TARGET_PARALLEL"
fi

# Comprobar makepkg.conf para evitar compilaciones con símbolos debug en AUR
if [ ! -f "$HOME/.makepkg.conf" ] && [ ! -f "${XDG_CONFIG_HOME:-$HOME/.config}/pacman/makepkg.conf" ]; then
    if [ -f "$DOTFILES_DIR/makepkg.conf" ]; then
        ln -sf "$DOTFILES_DIR/makepkg.conf" "$HOME/.makepkg.conf"
    else
        echo 'OPTIONS=(strip docs !libtool !staticlibs emptydirs zipman purge !debug lto)' > "$HOME/.makepkg.conf"
    fi
    log_ok "Configuración de makepkg optimizada (sin símbolos de debug pesados)."
fi

# -----------------------------------------------------------------------------
# FASE 2: Llaves del sistema y Repositorios
# -----------------------------------------------------------------------------
log_header "2/7. LLAVES DEL SISTEMA Y REPOSITORIOS"

if grep -q "\[blackarch\]" /etc/pacman.conf 2>/dev/null; then
    ml=/etc/pacman.d/blackarch-mirrorlist
    if [ -f "$ml" ]; then
        # Cedia suele saturarse con paquetes grandes
        sudo sed -i 's/^Server = .*cedia.org.ec/#&/' "$ml" 2>/dev/null || true
        sudo sed -i '/#Server = https:\/\/www.blackarch.org/s/^#//' "$ml" 2>/dev/null || true
        sudo sed -i '/#Server = https:\/\/mirrors.ocf.berkeley.edu/s/^#//' "$ml" 2>/dev/null || true
        sudo sed -i '/#Server = https:\/\/ftp2.osuosl.org/s/^#//' "$ml" 2>/dev/null || true
    fi
    log_info "Actualizando archlinux-keyring y blackarch-keyring..."
    sudo pacman -Sy --needed --noconfirm archlinux-keyring blackarch-keyring 2>/dev/null || \
    sudo pacman -Sy --needed --noconfirm archlinux-keyring 2>/dev/null || true
else
    log_info "Actualizando archlinux-keyring..."
    sudo pacman -Sy --needed --noconfirm archlinux-keyring 2>/dev/null || true
fi
log_ok "Llaves criptográficas de repositorios actualizadas."

# -----------------------------------------------------------------------------
# FASE 3: Actualización de Paquetes (Pacman + AUR)
# -----------------------------------------------------------------------------
log_header "3/7. ACTUALIZACIÓN DE PAQUETES (PACMAN Y AUR)"

UPDATE_FAILED=0
if command -v paru >/dev/null 2>&1; then
    log_info "Ejecutando paru -Syu..."
    paru -Syu "${EXTRA_ARGS[@]}" || UPDATE_FAILED=$?
elif command -v yay >/dev/null 2>&1; then
    log_info "Ejecutando yay -Syu..."
    yay -Syu "${EXTRA_ARGS[@]}" || UPDATE_FAILED=$?
else
    log_info "Ejecutando pacman -Syu..."
    sudo pacman -Syu "${EXTRA_ARGS[@]}" || UPDATE_FAILED=$?
fi

if [ "$UPDATE_FAILED" -ne 0 ]; then
    log_warn "Algun paquete reportó error durante la actualización."
    if [ -t 0 ]; then
        read -rp "¿Deseas reintentar compilar/instalar algún paquete específico? [nombre / N]: " retry_pkg
        while [[ -n "$retry_pkg" && ! "$retry_pkg" =~ ^[nN]$ ]]; do
            if [ -d "$HOME/.cache/paru/clone/$retry_pkg" ]; then
                log_info "Limpiando caché de compilación de $retry_pkg..."
                rm -rf "$HOME/.cache/paru/clone/$retry_pkg/src" "$HOME/.cache/paru/clone/$retry_pkg"/*.pkg.tar.zst 2>/dev/null || true
            fi
            if command -v paru >/dev/null 2>&1; then
                paru -S --rebuild "$retry_pkg" || log_err "No se pudo instalar $retry_pkg"
            elif command -v yay >/dev/null 2>&1; then
                yay -S --rebuild "$retry_pkg" || log_err "No se pudo instalar $retry_pkg"
            else
                sudo pacman -S "$retry_pkg" || log_err "No se pudo instalar $retry_pkg"
            fi
            echo
            read -rp "¿Reintentar otro paquete? [nombre / Enter para terminar]: " retry_pkg
        done
    fi
else
    log_ok "Paquetes nativos y AUR actualizados correctamente."
fi

# -----------------------------------------------------------------------------
# FASE 4: Aplicaciones Flatpak
# -----------------------------------------------------------------------------
log_header "4/7. APLICACIONES Y TIEMPOS DE EJECUCIÓN FLATPAK"

if [ "$SKIP_FLATPAK" = false ] && command -v flatpak >/dev/null 2>&1; then
    log_info "Actualizando Flatpaks del sistema y de usuario..."
    flatpak update -y || log_warn "Hubo un aviso al actualizar flatpaks."
    log_info "Limpiando dependencias y runtimes huérfanos de Flatpak..."
    flatpak uninstall --unused -y 2>/dev/null || true
    log_ok "Flatpaks actualizados y limpios."
else
    log_info "Flatpak omitido o no instalado."
fi

# -----------------------------------------------------------------------------
# FASE 5: Agent Skills de Antigravity
# -----------------------------------------------------------------------------
log_header "5/7. AGENT SKILLS DE ANTIGRAVITY"

if [ "$SKIP_SKILLS" = false ]; then
    SKILLS_BIN=""
    if [ -x "$HOME/.local/bin/skills" ]; then
        SKILLS_BIN="$HOME/.local/bin/skills"
    elif [ -x "$DOTFILES_DIR/skills/skills" ]; then
        SKILLS_BIN="$DOTFILES_DIR/skills/skills"
    fi

    if [ -n "$SKILLS_BIN" ]; then
        log_info "Actualizando repositorio de Agent Skills..."
        "$SKILLS_BIN" update || log_warn "Aviso al actualizar skills."
        log_ok "Agent Skills sincronizadas con el catálogo oficial."
    else
        log_info "Gestor de Agent Skills no encontrado en las rutas esperadas."
    fi
else
    log_info "Paso de Agent Skills omitido por argumento."
fi

# -----------------------------------------------------------------------------
# FASE 6: Sincronización y Configuración del Entorno (Dotfiles)
# -----------------------------------------------------------------------------
log_header "6/7. CONFIGURACIÓN Y SINCRONIZACIÓN DEL ENTORNO"

if [ "$SKIP_SYNC" = false ] && [ -d "$DOTFILES_DIR" ]; then
    log_info "Verificando scripts del usuario en ~/.local/bin..."
    mkdir -p "$HOME/.local/bin"
    if [ -d "$DOTFILES_DIR/scripts" ]; then
        for s in "$DOTFILES_DIR/scripts"/*; do
            [ -f "$s" ] || continue
            s_name=$(basename "$s")
            cp -f "$s" "$HOME/.local/bin/$s_name"
            chmod +x "$HOME/.local/bin/$s_name"
            [ -d "$HOME/.gemini/antigravity-ide/bin" ] && ln -sf "$HOME/.local/bin/$s_name" "$HOME/.gemini/antigravity-ide/bin/$s_name" 2>/dev/null || true
        done
        log_ok "Scripts sincronizados en ~/.local/bin/ y rutas del entorno"
    fi

    # Enlaces simbólicos clave
    [ -f "$DOTFILES_DIR/makepkg.conf" ] && ln -sf "$DOTFILES_DIR/makepkg.conf" "$HOME/.makepkg.conf"
    if [ -f "$DOTFILES_DIR/skills/skills" ]; then
        ln -sf "$DOTFILES_DIR/skills/skills" "$HOME/.local/bin/skills"
        [ -d "$HOME/.gemini/antigravity-ide/bin" ] && ln -sf "$DOTFILES_DIR/skills/skills" "$HOME/.gemini/antigravity-ide/bin/skills" 2>/dev/null || true
    fi

    if [ -f "$DOTFILES_DIR/zsh/.zshrc" ]; then
        mkdir -p "$HOME/.zsh"
        [ -f "$HOME/.zsh/.zshrc" ] || cp -f "$DOTFILES_DIR/zsh/.zshrc" "$HOME/.zsh/.zshrc"
        ln -sf "$HOME/.zsh/.zshrc" "$HOME/.zshrc"
    fi

    # Actualizar accesos directos de aplicaciones si existen
    if [ -d "$DOTFILES_DIR/applications" ]; then
        mkdir -p "$HOME/.local/share/applications"
        for app in "$DOTFILES_DIR/applications"/*; do
            [ -f "$app" ] || continue
            cp -f "$app" "$HOME/.local/share/applications/$(basename "$app")"
        done
        command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database "$HOME/.local/share/applications" 2>/dev/null || true
        log_ok "Accesos directos de escritorio (.desktop) sincronizados."
    fi

    # Recargar Niri si está corriendo
    if pgrep -x niri >/dev/null 2>&1; then
        if command -v niri >/dev/null 2>&1; then
            niri msg action load-config-file 2>/dev/null && log_ok "Compositor Niri: Configuración recargada exitosamente." || true
        fi
    fi

    log_ok "Entorno y dotfiles verificados y configurados correctamente."
else
    log_info "Sincronización de entorno omitida."
fi

# -----------------------------------------------------------------------------
# FASE 7: Mantenimiento (Huérfanos, Caché) y Verificación de Reinicio
# -----------------------------------------------------------------------------
log_header "7/7. MANTENIMIENTO DEL SISTEMA Y ESTADO FINAL"

# Huérfanos
ORPHANS=$(pacman -Qtdq 2>/dev/null || true)
if [ -n "$ORPHANS" ]; then
    echo -e "${YELLOW}Paquetes huérfanos detectados:${NC}"
    echo "$ORPHANS"
    if [ -t 0 ]; then
        read -rp "¿Deseas desinstalar estos paquetes huérfanos? [s/N]: " rm_orphans
        if [[ "$rm_orphans" =~ ^[sS]$ ]]; then
            sudo pacman -Rns $ORPHANS || true
            log_ok "Huérfanos eliminados."
        fi
    else
        log_info "Ejecuta 'sudo pacman -Rns \$(pacman -Qtdq)' para limpiar huérfanos si lo deseas."
    fi
else
    log_ok "Sin paquetes huérfanos."
fi

# Limpieza de caché
if command -v paccache >/dev/null 2>&1; then
    log_info "Optimizando caché de paquetes con paccache..."
    sudo paccache -r 2>/dev/null || true
    sudo paccache -ruk0 2>/dev/null || true
    log_ok "Caché de paquetes optimizada."
fi

# Verificación de reinicio de Kernel o servicios críticos
RUNNING_KERNEL=$(uname -r | cut -d- -f1)
INSTALLED_KERNEL=$(pacman -Q linux 2>/dev/null | awk '{print $2}' | cut -d. -f1-3 || true)
if [ -z "$INSTALLED_KERNEL" ]; then
    INSTALLED_KERNEL=$(pacman -Q linux-zen 2>/dev/null | awk '{print $2}' | cut -d. -f1-3 || \
                       pacman -Q linux-lts 2>/dev/null | awk '{print $2}' | cut -d. -f1-3 || true)
fi

REBOOT_RECOMMENDED=false

if [ -n "$INSTALLED_KERNEL" ] && [[ "$RUNNING_KERNEL" != *"$INSTALLED_KERNEL"* ]]; then
    echo -e "\n${RED}${BOLD}⚠ ATENCIÓN: El Kernel se ha actualizado (En ejecución: $RUNNING_KERNEL -> Instalado: $INSTALLED_KERNEL).${NC}"
    REBOOT_RECOMMENDED=true
fi

if tail -n 100 /var/log/pacman.log 2>/dev/null | grep -q -E "upgraded (systemd|niri|dbus|mesa|wayland)"; then
    echo -e "${YELLOW}${BOLD}ℹ Nota: Se actualizaron componentes base (systemd, niri, dbus o controladores gráficos).${NC}"
    REBOOT_RECOMMENDED=true
fi

if [ "$REBOOT_RECOMMENDED" = true ]; then
    echo -e "${YELLOW}Se recomienda reiniciar el equipo para cargar el nuevo kernel y servicios.${NC}"
else
    log_ok "No se requiere reinicio. El sistema está totalmente sincronizado y listo para trabajar."
fi

echo -e "\n${GREEN}${BOLD}✔ ¡ACTUALIZACIÓN Y CONFIGURACIÓN COMPLETADA CON ÉXITO!${NC}\n"
