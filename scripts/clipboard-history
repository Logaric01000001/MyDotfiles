#!/bin/bash
# historial del portapapeles con cliphist

command -v cliphist >/dev/null || { notify-send "Error" "falta cliphist"; exit 1; }

SELECTED=$(cliphist list | fuzzel --dmenu -l 10 -w 300)

if [ -n "$SELECTED" ]; then
    echo "$SELECTED" | cliphist decode | wl-copy
    notify-send "Clipboard" "copiado"
fi
