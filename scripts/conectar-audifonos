#!/usr/bin/env bash
# empareja los audifonos desde cero (maxell / dynamic / mt)
set -e

clear 2>/dev/null || true
echo "Antes:"
echo "  - apaga el bluetooth del celular"
echo "  - con los audifonos apagados, deja presionado el boton 5-7 seg"
echo "    hasta que parpadee rojo/azul"
echo
read -rp "Enter cuando este parpadeando... "

echo "buscando..."
bluetoothctl scan bredr >/dev/null 2>&1 &
SCAN_PID=$!

MAC=""
NAME=""
for i in {1..20}; do
    FOUND=$(bluetoothctl devices | grep -i -E "MAXELL|DYNAMIC|MT" | head -n1 || true)
    if [ -n "$FOUND" ]; then
        MAC=$(echo "$FOUND" | awk '{print $2}')
        NAME=$(echo "$FOUND" | cut -d' ' -f3-)
        break
    fi
    echo -ne " $i/20\r"
    sleep 1
done

kill $SCAN_PID 2>/dev/null || true
wait $SCAN_PID 2>/dev/null || true

if [ -z "$MAC" ]; then
    echo "no los encontre, revisa que esten en modo pairing"
    exit 1
fi

echo "encontrados: $NAME ($MAC)"

# borrar la clave vieja, si no da Permission denied
bluetoothctl remove "$MAC" >/dev/null 2>&1 || true
sleep 1

bluetoothctl pair "$MAC"
bluetoothctl trust "$MAC"
bluetoothctl connect "$MAC"
sleep 2

if bluetoothctl info "$MAC" 2>/dev/null | grep -q "Connected: yes"; then
    echo "conectados"
else
    echo "reintentando..."
    bluetoothctl connect "$MAC"
fi
