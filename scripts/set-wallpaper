#!/usr/bin/env bash
# fondos para noctalia (inside) y silentsddm (outside)
set -e

WALLPAPERS_DIR="$HOME/Imágenes/Fondos"
CURRENT_DESKTOP_WP="$HOME/.config/current_wallpaper"
SDDM_THEME_DIR="/usr/share/sddm/themes/SilentSDDM"
SDDM_BG_DIR="$SDDM_THEME_DIR/backgrounds"
SDDM_CONF_FILE="$SDDM_THEME_DIR/configs/default-left.conf"

mkdir -p "$WALLPAPERS_DIR" "$HOME/.config"

notify() {
    command -v notify-send &>/dev/null && notify-send -a "Fondos" -i preferences-desktop-wallpaper "$1" "$2" 2>/dev/null || true
}

find_images() {
    find "$WALLPAPERS_DIR" -maxdepth 2 -type f \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.webp" \) 2>/dev/null | sort
}

get_images() {
    local imgs
    mapfile -t imgs < <(find_images)
    # si la carpeta esta vacia, copiar los del tema de sddm
    if [ ${#imgs[@]} -eq 0 ] && [ -d "$SDDM_BG_DIR" ]; then
        cp -n "$SDDM_BG_DIR"/* "$WALLPAPERS_DIR/" 2>/dev/null || true
        mapfile -t imgs < <(find_images)
    fi
    printf "%s\n" "${imgs[@]}"
}

prompt_image() {
    local images=()
    while IFS= read -r line; do
        [ -n "$line" ] && images+=("$line")
    done < <(get_images)

    if [ ${#images[@]} -eq 0 ]; then
        notify "Fondos" "no hay imagenes en $WALLPAPERS_DIR"
        exit 0
    fi

    local selected
    selected=$(for f in "${images[@]}"; do basename "$f"; done | rofi -dmenu -i -p "$1")
    [ -z "$selected" ] && exit 0

    for f in "${images[@]}"; do
        if [ "$(basename "$f")" = "$selected" ]; then
            echo "$f"
            return 0
        fi
    done
}

as_root() {
    if command -v pkexec &>/dev/null; then
        pkexec "$@"
    elif command -v sudo &>/dev/null; then
        sudo "$@"
    fi
}

set_inside() {
    local img="$1"
    [ -f "$img" ] || { echo "no existe: $img"; exit 1; }

    cp -f "$img" "$CURRENT_DESKTOP_WP"
    pkill -x swaybg 2>/dev/null || true

    if command -v noctalia &>/dev/null && pgrep -x noctalia &>/dev/null; then
        noctalia msg wallpaper-set "$img" 2>/dev/null || true
    else
        swaybg -i "$CURRENT_DESKTOP_WP" -m fill &>/dev/null &
        disown
    fi

    echo "escritorio: $img"
    notify "Fondo" "escritorio actualizado"
}

set_outside() {
    local img="$1"
    [ -f "$img" ] || { echo "no existe: $img"; exit 1; }

    if [ ! -d "$SDDM_THEME_DIR" ]; then
        echo "no esta SilentSDDM en $SDDM_THEME_DIR"
        return
    fi

    local target_filename="current_wallpaper.${img##*.}"
    local target_path="$SDDM_BG_DIR/$target_filename"
    local sed_expr="s|^background = .*|background = \"$target_filename\"|g"

    if [ -w "$SDDM_BG_DIR" ]; then
        cp -f "$img" "$target_path"
    else
        as_root cp -f "$img" "$target_path"
    fi

    if [ -f "$SDDM_CONF_FILE" ]; then
        if [ -w "$SDDM_CONF_FILE" ]; then
            sed -i "$sed_expr" "$SDDM_CONF_FILE"
        else
            as_root sed -i "$sed_expr" "$SDDM_CONF_FILE"
        fi
    fi

    echo "sddm: $img"
    notify "Fondo" "sddm actualizado"
}

set_all() {
    set_inside "$1"
    set_outside "$1"
}

pick_or_use() {
    local fn="$1" title="$2" img="$3"
    if [ -z "$img" ]; then
        img=$(prompt_image "$title")
    fi
    [ -n "$img" ] && "$fn" "$img"
}

MODE="${1:-}"
IMAGE="${2:-}"

case "$MODE" in
    select-all|menu-all)                pick_or_use set_all     "Fondo (todo):" "" ;;
    select-inside|menu-inside|select-desktop) pick_or_use set_inside "Fondo (escritorio):" "" ;;
    select-outside|menu-outside|select-sddm)  pick_or_use set_outside "Fondo (sddm):" "" ;;
    all|todo|both)                      pick_or_use set_all     "Fondo (todo):" "$IMAGE" ;;
    inside|desktop|dentro)              pick_or_use set_inside  "Fondo (escritorio):" "$IMAGE" ;;
    outside|sddm|fuera|login)           pick_or_use set_outside "Fondo (sddm):" "$IMAGE" ;;
    menu|interactive|"")
        chosen=$(prompt_image "Fondo:")
        [ -z "$chosen" ] && exit 0
        target=$(printf "Todo\nEscritorio\nSDDM\n" | rofi -dmenu -i -p "Aplicar en:")
        case "$target" in
            Todo)       set_all "$chosen" ;;
            Escritorio) set_inside "$chosen" ;;
            SDDM)       set_outside "$chosen" ;;
        esac
        ;;
    *)
        if [ -f "$MODE" ]; then
            set_all "$MODE"
        else
            echo "uso: set-wallpaper [select-all|select-inside|select-outside|all|inside|outside] [imagen]"
        fi
        ;;
esac
