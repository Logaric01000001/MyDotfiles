/* =============================================================================
 *   ROFI — tema base (lanzador Super+D / Super+Space)
 *   Colores: noctalia.rasi (generado por Noctalia desde el fondo de pantalla).
 *   Variantes: cheatsheet.rasi (Super+Shift+H), menu.rasi (energía, pantallas),
 *              wallpaper.rasi (selector de fondos).
 * ============================================================================= */

@theme "/dev/null"
@import "noctalia.rasi"

configuration {
    modi:                   "drun,run";
    show-icons:             true;
    icon-theme:             "Catppuccin-Mocha";
    font:                   "Adwaita Sans 11";
    display-drun:           "";
    display-run:            "";
    drun-display-format:    "{name}";
    drun-match-fields:      "name,generic,exec,categories,keywords";
    matching:               "fuzzy";
    sorting-method:         "fzf";
    sort:                   true;
    case-sensitive:         false;
    cycle:                  true;
    terminal:               "kitty";
    hover-select:           true;
    me-select-entry:        "";
    me-accept-entry:        "MousePrimary";
}

* {
    background-color: transparent;
    text-color:       @fg;
    muted:            @border;
    margin:           0;
    padding:          0;
    spacing:          0;
}

window {
    width:            560px;
    background-color: @bg;
    border:           1px solid;
    border-color:     @bg-alt;
    border-radius:    16px;
    padding:          8px;
    location:         center;
    anchor:           center;
}

mainbox {
    children:         [ "inputbar", "message", "listview" ];
    spacing:          6px;
}

inputbar {
    children:         [ "prompt", "entry" ];
    background-color: @bg-alt;
    border-radius:    10px;
    padding:          12px 14px;
    spacing:          12px;
}

prompt {
    text-color:       @muted;
    font:             "JetBrainsMono Nerd Font 12";
    vertical-align:   0.5;
}

entry {
    text-color:        @fg;
    placeholder:       "Buscar";
    placeholder-color: @muted;
    cursor:            text;
    vertical-align:    0.5;
}

message {
    background-color: transparent;
    padding:          6px 14px 2px 14px;
}

textbox {
    text-color:       @muted;
    font:             "Adwaita Sans 9.5";
    markup:           true;
}

listview {
    lines:            8;
    columns:          1;
    spacing:          2px;
    padding:          4px 0 0 0;
    cycle:            true;
    dynamic:          true;
    fixed-height:     false;
    scrollbar:        false;
}

element {
    padding:          9px 12px;
    border:           0 0 0 2px solid;
    border-color:     transparent;
    border-radius:    8px;
    spacing:          12px;
    cursor:           pointer;
}

element-icon {
    size:             22px;
    vertical-align:   0.5;
    cursor:           inherit;
}

element-text {
    text-color:       inherit;
    vertical-align:   0.5;
    cursor:           inherit;
}

element selected,
element selected.normal,
element selected.active {
    background-color: @bg-alt;
    border-color:     @accent;
    text-color:       @fg;
}

element normal.normal,
element alternate.normal,
element normal.urgent,
element alternate.urgent {
    background-color: transparent;
    text-color:       @fg;
}

element normal.active,
element alternate.active {
    text-color:       @accent;
}
