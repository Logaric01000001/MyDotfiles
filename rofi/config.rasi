/* =============================================================================
 *   ROFI — LANZADOR DE APLICACIONES (WIN + D)
 *   Los colores los genera Noctalia desde el fondo de pantalla.
 * ============================================================================= */

@import "noctalia.rasi"

configuration {
    modi:                   "drun,run";
    show-icons:             true;
    icon-theme:             "Catppuccin-Mocha";
    font:                   "JetBrains Mono Nerd Font 11";
    display-drun:           "󰀻";
    drun-display-format:    "{name}";
    drun-match-fields:      "name,generic,exec,categories,keywords";
    matching:               "fuzzy";
    sorting-method:         "fzf";
    sort:                   true;
    case-sensitive:         false;
    cycle:                  true;
    terminal:               "kitty";
}

* {
    background-color: transparent;
    text-color:       @fg;
    margin:           0;
    padding:          0;
}

window {
    width:            540px;
    background-color: @bg;
    border:           1px;
    border-color:     @border;
    border-radius:    14px;
    padding:          16px;
    location:         center;
    anchor:           center;
}

mainbox {
    children:         [ "inputbar", "listview" ];
    spacing:          12px;
}

inputbar {
    children:         [ "prompt", "entry" ];
    background-color: @bg;
    border:           0 0 1px 0;
    border-color:     @border;
    padding:          0 0 12px 0;
    spacing:          10px;
}

prompt {
    text-color:       @accent;
    font:             "JetBrains Mono Nerd Font 12";
}

entry {
    text-color:        @fg;
    placeholder:       "Buscar aplicaciones…";
    placeholder-color: @border;
}

listview {
    lines:            8;
    columns:          1;
    spacing:          4px;
    cycle:            true;
    dynamic:          true;
    scrollbar:        false;
}

element {
    padding:          10px 12px;
    border-radius:    8px;
    spacing:          12px;
    text-color:       @fg;
}

element-icon {
    size:             24px;
}

element-text {
    text-color:       inherit;
    vertical-align:   0.5;
}

element selected {
    background-color: @accent;
    text-color:       @accent-fg;
}

element selected element-text {
    text-color:       @accent-fg;
}
